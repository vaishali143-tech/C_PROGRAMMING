SUM ARRAY

#include <stdio.h>
int main()
{
    int n,i,sum=0;
    scanf("%d",&n);
    int arr[n];
    for(i=0;i<n;i++)
    {scanf("%d",&arr[i]);
    sum=sum+arr[i];
    }
    printf("sum of elements :%d",sum);
}

AVERAGE IN ARRAY

#include <stdio.h>
int main()
{
    int n,i,sum=0;
    scanf("%d",&n);
    int arr[n];
    for(i=0;i<n;i++)
    {scanf("%d",&arr[i]);
    sum=sum+arr[i];
    }
    float avg=(float)sum/n;
    printf("avg of elements :%.2f",avg);
}

MAXIMUM IN ARRAY

#include <stdio.h>
int main()
{
    int n,i,max;
    scanf("%d",&n);
    int arr[n];
    for(i=0;i<n;i++)
    {scanf("%d",&arr[i]);
    }
    max=arr[0];
    for(i=0;i<n;i++)
    {
        if (arr[i]>max)
        max=arr[i];
    }
    printf("maximum of elemennt:%d",max);
}

