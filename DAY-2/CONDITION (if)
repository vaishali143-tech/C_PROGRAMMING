FIND LEAP YEAR

#include <stdio.h>
int main()
{
    int a;
    scanf("%d",&a);
    if((a%400 ==0)||(a%4 ==0 && a%100!=0))
    printf("leap year");
    else
    printf("not a leap year");
}

