while LOOP:

USING while LOOP COUNT THE INTEGERS

  #include <stdio.h>
int main()
{
   int n,c=0;
    scanf("%d",&n);
    while(n!=0)
    {
        n=n/10;
        c++;
    }
printf("%d",c);    
}

USING while LOOP FOR SUM OF NUMBERS

  #include <stdio.h>
int main()
{
    int n,sum=0,d;
    scanf("%d",&n);
    while(n!=0)
    {
        d=n%10;
        sum=sum=d;
        n=n/10;
    }
    printf("%d",sum);
}
